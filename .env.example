# Names only. Values live in Vercel env (per environment) or a 0600 file outside the repo.
# Never paste values in chat, tickets, docs or commits (secret-hygiene skill).
APP_DATA_CLASS=SYNTHETIC
DEMO_MODE=0
# Injected by the Vercel-managed Neon integration (prod = main branch, preview = branch per deployment)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Secrets (distinct per environment)
AUTH_SECRET=
CRON_SECRET=
OPENROUTER_API_KEY=
SIM_WEBHOOK_SECRET=
HMAC_PEPPER=
DATA_KEY=
# Non-secret config
# The demo logins have no env var: all three share DEMO_SHARED_PASSWORD in
# src/auth/demo-accounts.ts, which /login prints on each card (DECISION-LEDGER row 59).
# Optional; unset uses OpenFreeMap positron (ADR-008)
NEXT_PUBLIC_MAP_TILE_URL=
MIGRATE_PROD_ON_BUILD=
