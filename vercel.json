{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "iad1"
  ],
  "crons": [
    {
      "path": "/api/cron/sweep",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "src/app/api/queues/timer/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "ppec-timer"
        }
      ]
    },
    "src/app/api/queues/outbox/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "ppec-outbox"
        }
      ]
    },
    "src/app/api/queues/delay-probe/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "ppec-delay-probe"
        }
      ]
    }
  }
}
